# ThreatShield Application Settings
PROJECT_NAME="ThreatShield API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security Configurations
# Secret key used for signing JWT tokens and session cookies
# In production, this must be a secure randomly generated string
JWT_SECRET_KEY="threatshield_super_secret_key_for_jwt_tokens_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS settings - list of allowed origins, comma separated
# In production, specify actual frontend origins (e.g. https://threatshield.company.com)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000"

# Database Configuration
# ThreatShield will use SQLite for lightweight local storage and simple setup
DATABASE_URL="sqlite:///./threatshield.db"

# Cybersecurity / Engine Configurations
# Threshold score above which a transaction/request is flagged as malicious (0 to 100)
MALICIOUS_THRESHOLD=50
