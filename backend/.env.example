# Example environment variables for ThreatShield backend
# Copy this to `.env` and fill secrets before running in production.

PROJECT_NAME="ThreatShield API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security
# Replace with a strong randomly generated secret in production
JWT_SECRET_KEY="replace_this_with_a_strong_random_secret"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS - list only the dashboard domain(s) or other trusted origins
ALLOWED_ORIGINS="https://your-dashboard.example.com"

# Database - use a managed Postgres in production. Example:
# postgres://user:password@host:5432/dbname
DATABASE_URL="sqlite:///./threatshield.db"

# Engine tuning
MALICIOUS_THRESHOLD=50
